{
  "expo": {
    "name": "拍点啥",
    "slug": "pds_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-pds.png",
    "scheme": "pdsapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bpbp8.pdsapp",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EC",
        "foregroundImage": "./assets/images/android-icon-pds.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bpbp8.pdsapp",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-pds.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许拍点啥读取你选择的照片，用于发布单图作品。",
          "cameraPermission": "允许拍点啥使用相机拍摄并发布作品。",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许拍点啥使用你的位置，仅用于计算作品距离和附近推荐。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-pds.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EC",
          "dark": {
            "backgroundColor": "#F4F1EC"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
